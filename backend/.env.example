# Copy this file to ".env" and fill in your real key
GROQ_API_KEY=your_groq_api_key_here

# Database - default uses local SQLite (no setup needed).
# Swap this for a MySQL/Postgres URL later if you want, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/aivoa
DATABASE_URL=sqlite:///./complaints.db
